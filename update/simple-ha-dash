#!/bin/bash
# simple-ha-dash: installerar, uppdaterar och tar bort pekskärmspanelen simple_ha_dash på en platta med dash-avbilden.
#
#   simple-ha-dash install     installerar git vid behov, hämtar panelen från GitHub (repo_url i /etc/dash-update/config.ini),
#                              startar den, slår på den vid uppstart och hämtar spelen
#   simple-ha-dash update      senaste versionen av panelen (samma som knappen Uppdatera) och spelen
#   simple-ha-dash status      installerad version, tjänsten och spelen
#   simple-ha-dash remove      stänger av och tar bort panelen; inställningarna (/etc/dash-panel) och spelens
#                              sparfiler (/var/lib/dash-panel) ligger kvar, så en ny installation tar vid där den slutade
#
# Panelen heter internt fortfarande dash-panel (/opt/dash-panel, dash-panel.service). Själva bytet och kontrollen görs av
# dash-update (/usr/local/sbin/dash-update): den hämtar, provar, byter och lägger tillbaka förra versionen om den nya inte
# blir frisk. Det här skriptet ligger i avbilden (/usr/local/sbin/simple-ha-dash) och i repot (update/simple-ha-dash).
set -u

APP=/opt/dash-panel
UNIT=dash-panel.service
UNIT_FILE=/etc/systemd/system/$UNIT
CONF=/etc/dash-update/config.ini
UPDATER=${DASH_UPDATE_BIN:-/usr/local/sbin/dash-update}

say() { printf '%s\n' "$*"; }
die() { printf 'simple-ha-dash: %s\n' "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" = 0 ] || die "kör som root (logga in som root, eller sudo simple-ha-dash $1)"; }

repo_url() { sed -n 's/^[[:space:]]*repo_url[[:space:]]*=[[:space:]]*//p' "$CONF" 2>/dev/null | head -n1; }

ensure_basics() {
    [ -x "$UPDATER" ] || die "$UPDATER saknas (avbilden är för gammal; se README i repot)"
    [ -f "$CONF" ] || die "$CONF saknas"
    if ! command -v git >/dev/null 2>&1; then
        say "Installerar git (behövs för att hämta från GitHub, ca 30 MB) ..."
        export DEBIAN_FRONTEND=noninteractive
        timeout 600 apt-get update -qq || die "apt-get update misslyckades (är plattan på nätet?)"
        timeout 900 apt-get install -y -qq --no-install-recommends git >/dev/null || die "kunde inte installera git"
    fi
    local url host
    url=$(repo_url)
    host=$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#^git@##; s#[:/].*##')
    [ -n "$host" ] || die "ingen repo_url i $CONF"
    if ! timeout 20 getent hosts "$host" >/dev/null 2>&1; then
        die "når inte $host (är plattan på nätet?)"
    fi
}

sync_games() {
    [ -d "$APP/dashpanel" ] || return 0
    say "Hämtar spelen ..."
    (cd "$APP" && timeout 300 python3 -m dashpanel.gamesync) | sed 's/^/  /'
}

restart_panel() {
    systemctl restart "$UNIT" >/dev/null 2>&1 || true
}

cmd_install() {
    need_root install
    if [ -f "$APP/VERSION.json" ] && [ -f "$UNIT_FILE" ]; then
        say "Panelen är redan installerad. Uppdatera med:  simple-ha-dash update"
        cmd_status
        return 0
    fi
    ensure_basics
    say "Hämtar och installerar panelen från $(repo_url) ..."
    say "(den startas och följs i ca 40 sekunder innan den räknas som klar)"
    "$UPDATER" apply --with-unit
    rc=$?
    case $rc in
        0) ;;
        *) die "installationen gick inte igenom (dash-update avslutade med $rc); se: journalctl -t dash-update -b" ;;
    esac
    systemctl enable "$UNIT" >/dev/null 2>&1 || die "kunde inte slå på $UNIT"
    sync_games
    restart_panel
    say ""
    say "Klart. Panelen startar nu och vid varje uppstart."
    say "Välj vad som visas på redigeringssidan: http://$(hostname -I 2>/dev/null | awk '{print $1}'):8099"
}

cmd_update() {
    need_root update
    [ -d "$APP" ] || die "panelen är inte installerad; kör:  simple-ha-dash install"
    ensure_basics
    local extra=()
    [ "${1:-}" = "--with-unit" ] && extra=(--with-unit)
    "$UPDATER" apply "${extra[@]}"
    rc=$?
    case $rc in
        0) ;;
        2) say "Den nya versionen blev inte frisk; förra versionen är tillbaka." ;;
        5) say "Den nya versionen har en ändrad tjänstefil. Läs igenom den och kör:  simple-ha-dash update --with-unit"; return 5 ;;
        6) say "Koden i $APP har ändrats för hand; uppdateringen skulle skriva över det. Se: dash-update status"; return 6 ;;
        *) die "uppdateringen misslyckades (dash-update avslutade med $rc)" ;;
    esac
    sync_games
    restart_panel
}

cmd_status() {
    if [ ! -d "$APP" ]; then
        say "Panelen är inte installerad. Installera med:  simple-ha-dash install"
        return 0
    fi
    "$UPDATER" status 2>/dev/null || true
    say "Tjänsten:      $UNIT $(systemctl is-active $UNIT 2>/dev/null), $(systemctl is-enabled $UNIT 2>/dev/null)"
    say "Spel:          $(ls /var/lib/dash-panel/games 2>/dev/null | grep -E '\.py$' | tr '\n' ' ')"
}

cmd_remove() {
    need_root remove
    systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
    rm -f "$UNIT_FILE"
    systemctl daemon-reload
    rm -rf "$APP" "$APP.prev" "$APP.new" "$APP.failed"
    say "Panelen är borttagen. Inställningarna i /etc/dash-panel och spelen i /var/lib/dash-panel ligger kvar."
    say "Installera igen med:  simple-ha-dash install"
}

case "${1:-}" in
    install) cmd_install ;;
    update) shift; cmd_update "$@" ;;
    status) cmd_status ;;
    remove|uninstall) cmd_remove ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
