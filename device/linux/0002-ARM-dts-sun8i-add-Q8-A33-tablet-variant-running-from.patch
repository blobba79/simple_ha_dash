From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 15:57:53 +0200
Subject: [PATCH 2/4] ARM: dts: sun8i: add Q8 A33 tablet variant running from
 NAND (dash-nand)

NAND (Micron L84A MLC) with boot, kernel-a, kernel-b and an SLC-mode
UBI partition, and the 1024x600 panel described as panel-dpi with the
timings used by U-Boot for this tablet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XTGG1GSUkzofnshznl4jjt
---
 arch/arm/boot/dts/allwinner/Makefile          |  1 +
 .../sun8i-a33-q8-tablet-dashnand.dts          | 71 +++++++++++++++++++
 2 files changed, 72 insertions(+)
 create mode 100644 arch/arm/boot/dts/allwinner/sun8i-a33-q8-tablet-dashnand.dts

diff --git a/arch/arm/boot/dts/allwinner/Makefile b/arch/arm/boot/dts/allwinner/Makefile
index cd0d04488..730fe6f67 100644
--- a/arch/arm/boot/dts/allwinner/Makefile
+++ b/arch/arm/boot/dts/allwinner/Makefile
@@ -214,6 +214,7 @@ dtb-$(CONFIG_MACH_SUN8I) += \
 	sun8i-a33-ippo-q8h-v1.2.dtb \
 	sun8i-a33-olinuxino.dtb \
 	sun8i-a33-q8-tablet.dtb \
+	sun8i-a33-q8-tablet-dashnand.dtb \
 	sun8i-a33-sinlinx-sina33.dtb \
 	sun8i-a83t-allwinner-h8homlet-v2.dtb \
 	sun8i-a83t-bananapi-m3.dtb \
diff --git a/arch/arm/boot/dts/allwinner/sun8i-a33-q8-tablet-dashnand.dts b/arch/arm/boot/dts/allwinner/sun8i-a33-q8-tablet-dashnand.dts
new file mode 100644
index 000000000..6c5d5d5df
--- /dev/null
+++ b/arch/arm/boot/dts/allwinner/sun8i-a33-q8-tablet-dashnand.dts
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * dash-nand: Q8 A33 tablet (Abilia) running from internal NAND.
+ * NAND: Micron MT29F64G08CBABA (L84A MLC), 8 GiB, 2 MiB blocks.
+ * Layout: boot (SPL x2 + U-Boot x2), kernel-a, kernel-b, ubi (SLC mode).
+ * Panel: 1024x600, timings from the U-Boot defconfig of this tablet.
+ */
+#include "sun8i-a33-q8-tablet.dts"
+
+/ {
+	model = "Q8 A33 Tablet (dash-nand)";
+};
+
+&nfc {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	nand@0 {
+		reg = <0>;
+		allwinner,rb = <0>;
+		nand-ecc-strength = <40>;
+		nand-ecc-step-size = <1024>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <2>;
+			#size-cells = <2>;
+
+			partition@0 {
+				label = "boot";
+				reg = <0x0 0x0 0x0 0x1000000>;
+				read-only;
+			};
+
+			partition@1000000 {
+				label = "kernel-a";
+				reg = <0x0 0x1000000 0x0 0x2000000>;
+			};
+
+			partition@3000000 {
+				label = "kernel-b";
+				reg = <0x0 0x3000000 0x0 0x2000000>;
+			};
+
+			partition@5000000 {
+				label = "ubi";
+				reg = <0x0 0x5000000 0x1 0xfb000000>;
+				slc-mode;
+			};
+		};
+	};
+};
+
+&panel {
+	compatible = "panel-dpi";
+
+	panel-timing {
+		clock-frequency = <51000000>;
+		hactive = <1024>;
+		vactive = <600>;
+		hfront-porch = <160>;
+		hback-porch = <159>;
+		hsync-len = <1>;
+		vfront-porch = <12>;
+		vback-porch = <22>;
+		vsync-len = <1>;
+		hsync-active = <1>;
+		vsync-active = <1>;
+	};
+};
