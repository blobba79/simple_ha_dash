# Namn, adress, lösenord, nycklar, tidszon
# ---------------------------------------------------------------------------------------------------------------
def read_sid():
    base = P('/sys/bus/nvmem/devices')
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return None
    for n in names:
        try:
            # bara små enheter: på NAND-kärnan är varje MTD-partition också en nvmem-enhet (flera GB)
            with open('%s/%s/nvmem' % (base, n), 'rb') as f:
                data = f.read(64)
                if f.read(1):
                    continue
        except OSError:
            continue
        if len(data) in (16, 32) and any(data) and data != b'\xff' * len(data):
            return data
    return None


def derive_mac(st):
    """En egen, stabil Wi-Fi-adress per enhet. Chippets egen adress är densamma på alla enheter med samma firmware."""
    if st.d.get('mac'):
        return st.d['mac']
    sid = read_sid()
    h = hashlib.sha256(b'dash-wlan0-mac-v1' + (sid or os.urandom(16))).digest()
    b = bytearray(h[:6])
    b[0] = (b[0] & 0xFC) | 0x02                      # unicast, lokalt administrerad
    st.d['mac'] = ':'.join('%02x' % x for x in b)
    st.d['mac_from'] = 'chip-id' if sid else 'slump'
    return st.d['mac']


def sanitize_hostname(s):
    s = (s or '').strip().lower().translate(str.maketrans('åäöé', 'aaoe'))
    return re.sub(r'[^a-z0-9-]+', '-', s).strip('-')[:63]


def set_hostname(name):
    old = (read_text(P('/etc/hostname'), '') or '').strip()
    write_if_changed(P('/etc/hostname'), name + '\n')
    hosts = read_text(P('/etc/hosts'), '') or ''
    if old and old != name:
        hosts = re.sub(r'(?<![\w.-])%s(?![\w.-])' % re.escape(old), name, hosts)
    if not re.search(r'^127\.0\.1\.1\s', hosts, re.M):
        hosts = hosts.rstrip('\n') + '\n127.0.1.1   %s\n' % name
    elif name not in hosts:
        hosts = re.sub(r'^(127\.0\.1\.1\s+).*$', r'\g<1>' + name, hosts, flags=re.M)
    write_if_changed(P('/etc/hosts'), hosts)
    run(['hostname', name])
    log('namn: %s' % name)


def handle_identity(st, cfg, first):
    mac = derive_mac(st)
    want = sanitize_hostname(cfg.get('HOSTNAME', ''))
    if cfg.get('HOSTNAME') and not want:
        log('HOSTNAME innehåller inga giltiga tecken, ignoreras')
    if want:
        if st.changed('HOSTNAME', want):
            set_hostname(want)
            st.mark('HOSTNAME', want)
    elif first or not st.d.get('hostname_done'):
        set_hostname('dash-' + mac[-5:].replace(':', ''))
        st.d['hostname_done'] = True
    # Wi-Fi-adress: .link-filen gäller varje start (udev sätter adressen när gränssnittet skapas)
    mode = cfg.get('WIFI_MAC', 'auto').strip().lower() or 'auto'
    link = P('/etc/systemd/network/10-dash-wlan0.link')
    if mode == 'keep':
        if os.path.exists(link) and st.d.get('link_by_us'):
            os.remove(link)
            st.d['link_by_us'] = False
        return
    if re.match(r'^([0-9a-f]{2}:){5}[0-9a-f]{2}$', mode):
        mac = mode
    elif mode != 'auto':
        log('WIFI_MAC=%s förstås inte, använder auto' % mode)
    body = ('# Skapad av dash-firstboot. Ger wlan0 en egen adress i stället för chippets gemensamma.\n'
            '[Match]\nOriginalName=wlan0\n\n[Link]\nMACAddress=%s\n' % mac)
    write_if_changed(link, body)
    st.d['link_by_us'] = True
    # finns gränssnittet redan och är nere sätts adressen direkt (annars tar udev över vid nästa start)
    cur = (read_text(P('/sys/class/net/wlan0/address'), '') or '').strip()
    flags = (read_text(P('/sys/class/net/wlan0/flags'), '0x0') or '0x0').strip()
    if cur and cur != mac and not int(flags, 16) & 1:
        run(['ip', 'link', 'set', 'dev', 'wlan0', 'address', mac])
        log('Wi-Fi-adress %s' % mac)


def handle_host_keys():
    keys = [P('/etc/ssh/ssh_host_%s_key' % t) for t in ('rsa', 'ecdsa', 'ed25519')]
    if not all(os.path.exists(k) for k in keys):
        log('skapar ssh-värdnycklar')
        run(['ssh-keygen', '-A'], timeout=300)


def handle_update_key():
    """Egen deploy key för dash-update (hämtar panelens uppdateringar från GitHub). Skapas en gång per enhet och
    finns aldrig i avbilden. Publika delen visas i dash-info.txt så att den kan läggas in som Deploy key i repot."""
    key = P('/etc/dash-update/deploy_key')
    if not os.path.isdir(os.path.dirname(key)) or os.path.exists(key):          # ingen uppdaterare, eller redan skapad
        return
    name = (read_text(P('/etc/hostname'), '') or '').strip() or 'dash'
    log('skapar deploy key för dash-update')
    run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'dash-update@%s' % name, '-f', key], timeout=60)
    if os.path.exists(key):
        os.chmod(key, 0o600)


def handle_root_password(st, cfg):
    pw = cfg.get('ROOT_PASSWORD', '')
    if pw:
        if '\n' in pw or '\x00' in pw:
            log('ROOT_PASSWORD innehåller ogiltiga tecken, ignoreras')
        elif st.changed('ROOT_PASSWORD', pw):
            run(['chpasswd'], input='root:%s\n' % pw)
            st.mark('ROOT_PASSWORD', pw)
            st.d['root_pw_done'] = True
            st.d['generated'].pop('root_password', None)
            log('root-lösenordet satt från %s' % CFG_FILE)
    elif not st.d.get('root_pw_done'):
        pw = rand_password(14)
        run(['chpasswd'], input='root:%s\n' % pw)
        st.d['generated']['root_password'] = pw
        st.d['root_pw_done'] = True
        log('root-lösenord slumpades (står i %s på kortet)' % INFO_FILE)


KEY_RE = re.compile(r'^(ssh-(rsa|ed25519|dss)|ecdsa-sha2-nistp\d+|sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com)'
                    r'\s+[A-Za-z0-9+/=]+(\s.*)?$')


def handle_ssh_keys(st, pairs):
    keys = [v for k, v in pairs if re.match(r'^SSH_PUBLIC_KEY\d*$', k) and v]
    good = []
    for k in keys:
        if KEY_RE.match(k):
            good.append(k)
        else:
            log('en SSH_PUBLIC_KEY ser inte ut som en publik nyckel och hoppas över')
    if not good or not st.changed('SSH_PUBLIC_KEY', '\n'.join(good)):
        return
    path = P('/root/.ssh/authorized_keys')
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    os.chmod(os.path.dirname(path), 0o700)
    have = read_text(path, '') or ''
    have_blobs = {ln.split()[1] for ln in have.splitlines() if len(ln.split()) >= 2}
    add = [k for k in good if k.split()[1] not in have_blobs]
    if add:
        write_if_changed(path, have + ('' if have.endswith('\n') or not have else '\n') + '\n'.join(add) + '\n', 0o600)
        log('lade till %d ssh-nyckel/nycklar' % len(add))
    st.mark('SSH_PUBLIC_KEY', '\n'.join(good))


def handle_timezone(st, cfg, first):
    tz = cfg.get('TIMEZONE', '').strip()
    if not tz or not (first or st.changed('TIMEZONE', tz)):
        return
    if not re.match(r'^[A-Za-z0-9_+\-/]+$', tz) or '..' in tz or not os.path.isfile(P('/usr/share/zoneinfo/' + tz)):
        log('okänd tidszon %r, ignoreras' % tz)
        return
    lt = P('/etc/localtime')
    try:
        os.remove(lt)
    except OSError:
        pass
    os.symlink('/usr/share/zoneinfo/' + tz, lt)
    write_if_changed(P('/etc/timezone'), tz + '\n')
    st.mark('TIMEZONE', tz)
    log('tidszon %s' % tz)


