# Panelen (Home Assistant)
# ---------------------------------------------------------------------------------------------------------------
def build_ha_url(cfg):
    url = cfg.get('HA_URL', '').strip()
    if url:
        if re.match(r'^wss?://', url, re.I) and not url.lower().startswith('ws://'):
            log('HA_URL måste börja med ws:// (panelen stöder inte krypterad WebSocket), ignoreras')
            return None
        url = re.sub(r'^https?://', 'ws://', url, flags=re.I)
        if not re.match(r'^ws://[^/\s]+(/.*)?$', url):
            log('HA_URL ser inte rätt ut, ignoreras')
            return None
        return url if re.match(r'^ws://[^/]+/.+', url) else url.rstrip('/') + '/api/websocket'
    host = cfg.get('HA_HOST', '').strip()
    if not host:
        return None
    host = re.sub(r'^[A-Za-z]+://', '', host).split('/')[0]
    port = cfg.get('HA_PORT', '').strip() or '8123'
    if host.count(':') == 1:
        host, _, p2 = host.partition(':')
        port = p2 or port
    if not re.match(r'^[A-Za-z0-9.-]+$', host) or not port.isdigit() or not 0 < int(port) < 65536:
        log('HA_HOST/HA_PORT ser inte rätt ut, ignoreras')
        return None
    return 'ws://%s:%s/api/websocket' % (host, port)


def ha_host_of(url):
    return url.split('//', 1)[-1].split('/', 1)[0].rsplit(':', 1)[0] if url else ''


def handle_panel(st, cfg, first):
    path = P('/etc/dash-panel/config.json')
    url = build_ha_url(cfg)
    tz = cfg.get('TIMEZONE', '').strip()
    dirty = False
    try:
        with open(path, encoding='utf-8') as f:
            j = json.load(f)
        if not isinstance(j, dict):
            raise ValueError('inte ett objekt')
    except FileNotFoundError:
        j = {'version': 1}
    except (OSError, ValueError) as e:
        log('panelens config.json är trasig (%s), rör den inte' % e)
        j = None
    if j is not None:
        if url and st.changed('HA_URL', url):
            j.setdefault('ha', {})['url'] = url
            j['ha'].setdefault('token_file', '/etc/dash-panel/token')
            st.mark('HA_URL', url)
            dirty = True
        if tz and re.match(r'^[A-Za-z0-9_+\-/]+$', tz) and st.changed('PANEL_TZ', tz):
            j.setdefault('locale', {})['timezone'] = tz
            j['locale'].setdefault('decimal_separator', ',')
            st.mark('PANEL_TZ', tz)
            dirty = True
        if dirty:
            write_if_changed(path, json.dumps(j, ensure_ascii=False, indent=1) + '\n')
            log('panelens inställningar uppdaterade (Home Assistant: %s)' % (ha_host_of(url) or 'oförändrad'))
    tok = cfg.get('HA_TOKEN', '').strip()
    if tok:
        if re.search(r'\s', tok):
            log('HA_TOKEN innehåller mellanslag eller radbrytning, ignoreras')
        elif st.changed('HA_TOKEN', tok):
            write_if_changed(P('/etc/dash-panel/token'), tok + '\n', 0o600)
            st.mark('HA_TOKEN', tok)
            log('Home Assistant-token sparad')
    # nätloggen pingar Home Assistant; adressen ska vara kundens, inte någon annans
    if url and st.changed('NETLOG_HA', ha_host_of(url)):
        d = P('/etc/systemd/system/dash-netlog.service.d')
        body = '# Skapad av dash-firstboot.\n[Service]\nEnvironment="NETLOG_TARGETS=ha=%s"\n' % ha_host_of(url)
        if write_if_changed(d + '/targets.conf', body):
            st.d['units_dirty'] = True
        st.mark('NETLOG_HA', ha_host_of(url))


# ---------------------------------------------------------------------------------------------------------------
# Wi-Fi (netplan) och reservnätets lösenord
# ---------------------------------------------------------------------------------------------------------------
def jq(s):
    return json.dumps(s, ensure_ascii=False)


def build_netplan(cfg):
    aps, warns = [], []
    for sfx in ('', '2', '3', '4'):
        ssid = cfg.get('WIFI%s_SSID' % sfx, '')
        if not ssid:
            continue
        pw = cfg.get('WIFI%s_PASSWORD' % sfx, '')
        hidden = cfg.get('WIFI%s_HIDDEN' % sfx, '').strip().lower() in ('ja', 'yes', 'true', '1')
        if len(ssid.encode('utf-8')) > 32:
            warns.append('WIFI%s_SSID är längre än 32 byte, hoppas över' % sfx)
        elif pw and not (8 <= len(pw) <= 63 or re.match(r'^[0-9A-Fa-f]{64}$', pw)):
            warns.append('WIFI%s_PASSWORD måste vara 8-63 tecken, nätet hoppas över' % sfx)
        elif '\n' in pw or '\n' in ssid:
            warns.append('WIFI%s innehåller radbrytning, hoppas över' % sfx)
        else:
            aps.append((ssid, pw, hidden))
    if not aps:
        return None, warns
    out = ['# Skapad av dash-firstboot ur dash-config.txt. Ändra där, inte här (filen skrivs om när den ändras).',
           'network:', '  version: 2', '  renderer: networkd', '  wifis:', '    wlan0:', '      dhcp4: true',
           '      dhcp6: true']
    country = cfg.get('WIFI_COUNTRY', '').strip().upper()
    if re.match(r'^[A-Z]{2}$', country):
        out.append('      regulatory-domain: %s' % jq(country))
    elif country:
        warns.append('WIFI_COUNTRY ska vara två bokstäver, ignoreras')
    out.append('      access-points:')
    for ssid, pw, hidden in aps:
        if not pw and not hidden:
            out.append('        %s: {}' % jq(ssid))
            continue
        out.append('        %s:' % jq(ssid))
        if pw:
            out.append('          password: %s' % jq(pw))
        if hidden:
            out.append('          hidden: true')
    return '\n'.join(out) + '\n', warns


def handle_wifi(st, cfg):
    text, warns = build_netplan(cfg)
    for w in warns:
        log(w)
    if not text:
        return
    try:
        import yaml
        yaml.safe_load(text)
    except ImportError:
        pass
    except Exception as e:                                   # en trasig netplan-fil skulle slå ut allt nät
        log('den genererade Wi-Fi-filen blev ogiltig (%s), används inte' % type(e).__name__)
        return
    if write_if_changed(P('/etc/netplan/60-dash-wifi.yaml'), text, 0o600):
        st.d['net_dirty'] = True
        log('Wi-Fi inställt (nät: %s)' % ', '.join(cfg[k] for k in ('WIFI_SSID', 'WIFI2_SSID', 'WIFI3_SSID', 'WIFI4_SSID')
                                                   if cfg.get(k)))


def shell_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"


def handle_rescue(st, cfg):
    path = P('/etc/wifi-rescue.conf')
    text = read_text(path, '') or ''
    m = re.search(r"^PSK=(.*)$", text, re.M)
    have = m is not None and len(m.group(1).strip("'\"")) >= 8
    pw = cfg.get('RESCUE_PASSWORD', '')
    new = None
    if pw:
        if not 8 <= len(pw) <= 63 or '\n' in pw:
            log('RESCUE_PASSWORD måste vara 8-63 tecken, ignoreras')
        elif st.changed('RESCUE_PASSWORD', pw):
            new = pw
            st.mark('RESCUE_PASSWORD', pw)
            st.d['generated'].pop('rescue_password', None)
    elif not have:
        new = rand_password(12)
        st.d['generated']['rescue_password'] = new
    if new is None:
        return
    line = 'PSK=%s' % shell_quote(new)
    if m:
        text = re.sub(r'^PSK=.*$', lambda _: line, text, count=1, flags=re.M)
    else:
        if not text:
            text = ('# Inställningar för reservnätet (wifi-rescue). Skapad av dash-firstboot. Endast root kan läsa filen.\n'
                    '# Nätnamnet blir automatiskt "dash-" + sista 4 tecknen i Wi-Fi-adressen.\n'
                    '# Lösenordet kräver minst 8 tecken (WPA2).\n')
        text = text.rstrip('\n') + '\n' + line + '\n'
    write_if_changed(path, text, 0o600)
    log('reservnätets lösenord satt')


# ---------------------------------------------------------------------------------------------------------------
# dash-info.txt: sammanfattning som syns när kortet sätts i en dator
# ---------------------------------------------------------------------------------------------------------------
def current_ip():
    r = run(['ip', '-4', '-o', 'addr', 'show', 'scope', 'global'])
    for ln in r.stdout.splitlines():
        m = re.search(r'^\d+:\s+(\S+)\s+inet\s+(\d+\.\d+\.\d+\.\d+)/', ln)
        if m and m.group(2) != RESCUE_ADDR:
            return m.group(1), m.group(2)
    return None, None


def build_info(st, cfg, ip):
    name = (read_text(P('/etc/hostname'), '') or '').strip()
    mac4 = (read_text(P('/sys/class/net/wlan0/address'), st.d.get('mac', '')) or '').strip().replace(':', '')[-4:]
    g = st.d['generated']
    L = ['dash - status', '=============', '',
         'Den här filen skrivs av dash vid start. Ändra inget här; inställningarna står i dash-config.txt.', '']
    L.append('Namn:                 %s' % (name or '?'))
    L.append('Wi-Fi-adress (MAC):   %s' % ((read_text(P('/sys/class/net/wlan0/address'), '') or '').strip()
                                          or st.d.get('mac', '?')))
    if ip:
        L.append('Nätadress (IP):       %s   (senast sedd %s)' % (ip, time.strftime('%Y-%m-%d %H:%M')))
        L.append('Redigera panelen:     http://%s:8099   (från mobil eller dator på samma nät)' % ip)
        L.append('Logga in med ssh:     ssh root@%s' % ip)
    else:
        L.append('Nätadress (IP):       ingen ännu - dash har inte kommit ut på något Wi-Fi')
    ssids = [cfg[k] for k in ('WIFI_SSID', 'WIFI2_SSID', 'WIFI3_SSID', 'WIFI4_SSID') if cfg.get(k)]
    L.append('Wi-Fi som angetts:    %s' % (', '.join(ssids) if ssids else '(inget - fyll i WIFI_SSID i dash-config.txt)'))
    if g.get('root_password'):
        L.append('Root-lösenord:        %s   (slumpat; gäller tills du byter det)' % g['root_password'])
    resc = g.get('rescue_password')
    L.append('')
    L.append('Reservnät: om dash inte når något Wi-Fi startar det ett eget nät efter ca 90 sekunder.')
    L.append('  Nätnamn:    dash-%s' % (mac4 or 'xxxx'))
    if resc:
        L.append('  Lösenord:   %s' % resc)
    else:
        L.append('  Lösenord:   det du angett som RESCUE_PASSWORD')
    L.append('  Anslut mobilen dit och logga in med: ssh root@%s' % RESCUE_ADDR)
    L.append('')
    pub = (read_text(P('/etc/dash-update/deploy_key.pub'), '') or '').strip()
    if pub:
        L.append('')
        L.append('Uppdateringar av panelen (valfritt): dash kan hämta nya versioner av panelen från GitHub.')
        L.append('  1. Logga in med ssh och kör en gång:  dash-update-setup   (installerar git; dash måste vara på nätet)')
        L.append('  2. Skicka raden nedan till den som gav dig avbilden, som lägger in den som Deploy key (utan skrivrätt):')
        L.append('     %s' % pub)
        L.append('  3. Sedan:  dash-update check   och   dash-update apply   (uppdateringar installeras aldrig av sig själva)')
    L.append('')
    L.append('Tips: fungerar inget, sätt kortet i datorn, rätta dash-config.txt och starta om dash.')
    return '\r\n'.join(L) + '\r\n'


def write_info(store, st, cfg, ip):
    text = build_info(st, cfg, ip)
    key = re.sub(r'senast sedd [^)]*', '', text)
    if st.d.get('info_digest') == digest(key):
        return
    if store.write(INFO_FILE, text):
        st.d['info_digest'] = digest(key)


# ---------------------------------------------------------------------------------------------------------------
# Kommandon
# ---------------------------------------------------------------------------------------------------------------
def load_cfg(store):
    data = store.read(CFG_FILE)
    if data is None:
        if store.dir:
            log('%s saknas på DASHCFG' % CFG_FILE)
        return '', {}, []
    text = data.decode('utf-8-sig', 'replace')
    cfg, pairs = parse_config(text)
    return text, cfg, pairs


def guarded(name, fn, *a):
    try:
        return fn(*a)
    except Exception:                                           # ett fel i en del får aldrig stoppa resten
        log('fel i %s:\n%s' % (name, traceback.format_exc()))


def cmd_early():
    st = State()
    first = not st.d.get('first_boot_done')
    log('start (%s)' % ('första starten' if first else 'vanlig start'))
    guarded('grow_root', grow_root, st)
    store = CfgStore()
    try:
        opened = store.open()
        text, cfg, pairs = load_cfg(store) if opened else ('', {}, [])
        guarded('identity', handle_identity, st, cfg, first)
        guarded('host_keys', handle_host_keys)
        guarded('update_key', handle_update_key)
        guarded('root_password', handle_root_password, st, cfg)
        guarded('ssh_keys', handle_ssh_keys, st, pairs)
        guarded('timezone', handle_timezone, st, cfg, first)
        guarded('panel', handle_panel, st, cfg, first)
        guarded('wifi', handle_wifi, st, cfg)
        guarded('rescue', handle_rescue, st, cfg)
        if st.d.pop('units_dirty', False):
            run(['systemctl', 'daemon-reload'])
        if opened and cfg.get('WIPE_SECRETS', '').lower() in ('ja', 'yes', 'true', '1'):
            new, n = text, 0
            for k in SECRET_KEYS:
                if cfg.get(k):
                    new, c = re.subn(r'(?im)^(\s*%s\s*=).*$' % k, lambda m: m.group(1), new)
                    n += c
            if n and store.write(CFG_FILE, new.encode('utf-8')):
                log('tömde %d hemliga värden i %s' % (n, CFG_FILE))
        st.d['first_boot_done'] = st.d.get('first_boot_done') or time.strftime('%Y-%m-%d %H:%M:%S')
        st.save()
        # reservnätets uppgifter ska finnas på kortet direkt, även om nätet aldrig kommer upp
        if opened:
            guarded('info', write_info, store, st, cfg, None)
            st.save()
    finally:
        store.close()
    log('klart')


def cmd_net():
    st = State()
    if not st.d.get('net_dirty'):
        return
    r = run(['netplan', 'generate'])
    if r.returncode != 0:
        bad = P('/etc/netplan/60-dash-wifi.yaml')
        log('netplan godtog inte Wi-Fi-filen (%s); flyttar undan den' % (r.stderr or r.stdout).strip()[:200])
        if os.path.exists(bad):
            os.replace(bad, bad + '.rejected')
        st.d['net_dirty'] = False
        st.save()
        run(['netplan', 'generate'])
        return
    r = run(['netplan', 'apply'], timeout=180)
    log('netplan apply: %s' % ('ok' if r.returncode == 0 else (r.stderr or r.stdout).strip()[:200]))
    st.d['net_dirty'] = False
    st.save()


def cmd_info():
    st = State()
    store = CfgStore()
    try:
        if not store.open():
            return
        text, cfg, _ = load_cfg(store)
        ip = None
        for _ in range(60):                                      # högst ca 3 minuter
            _, ip = current_ip()
            if ip:
                break
            time.sleep(3)
        write_info(store, st, cfg, ip)
        st.save()
    finally:
        store.close()


def cmd_status():
    st = State()
    print('första start gjord:  %s' % st.d.get('first_boot_done', 'nej'))
    print('Wi-Fi-adress:        %s (%s)' % (st.d.get('mac', '-'), st.d.get('mac_from', '-')))
    print('tillämpade värden:   %s' % (', '.join(sorted(st.d['applied'])) or '-'))
    print('nät ej tillämpat:    %s' % ('ja' if st.d.get('net_dirty') else 'nej'))
    print('logg:                %s/log' % STATE_DIR)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    fn = {'early': cmd_early, 'net': cmd_net, 'info': cmd_info, 'status': cmd_status}.get(cmd)
    if not fn:
        print(__doc__)
        return 2
    try:
        fn()
    except Exception:
        log('oväntat fel i %s:\n%s' % (cmd, traceback.format_exc()))
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
