#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""dash-firstboot - första start och inställningar från kortets DASHCFG-partition.

  dash-firstboot early    före nätverk och ssh: växer rotpartitionen, namn, ssh-nycklar, lösenord, panelens inställningar
  dash-firstboot net      efter att nätverket startat: tillämpar nya Wi-Fi-inställningar (netplan apply)
  dash-firstboot info     väntar på nätadress och skriver dash-info.txt på kortet
  dash-firstboot status   visar vad som är gjort (inga hemligheter)

Inställningarna står i dash-config.txt på partitionen DASHCFG (FAT16, syns i Windows/macOS/Linux). Filen läses vid
varje start. Ett tomt värde betyder "rör inte". Ett värde tillämpas bara när det är nytt eller ändrat sedan sist,
så att till exempel ett lösenord du bytt med passwd inte skrivs över vid varje uppstart.

Miljövariabler för prov (aldrig satta i drift):
  DASH_ROOT=/katalog     alla sökvägar får detta prefix
  DASH_NOEXEC=1          kommandon skrivs till $DASH_ROOT/noexec.log i stället för att köras
  DASH_CFG_DIR=/katalog  läs och skriv konfigurationen här i stället för att montera DASHCFG
"""
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import time
import traceback

ROOT = os.environ.get('DASH_ROOT', '').rstrip('/')
NOEXEC = os.environ.get('DASH_NOEXEC') == '1'
CFG_DIR = os.environ.get('DASH_CFG_DIR')
# dash-nand: systemet kör från NAND (ingen DASHCFG). Inställningarna ligger i /etc/dash-cfg och skrivs dit vid installationen.
if not CFG_DIR and os.path.exists(os.environ.get('DASH_ROOT', '').rstrip('/') + '/etc/dash-nand'):
    CFG_DIR = os.environ.get('DASH_ROOT', '').rstrip('/') + '/etc/dash-cfg'
CFG_LABEL = 'DASHCFG'
CFG_FILE = 'dash-config.txt'
INFO_FILE = 'dash-info.txt'
CFG_MNT = '/run/dash-cfg'
RESCUE_ADDR = '192.168.4.1'
WORDS = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789'      # inga tecken som liknar varandra
SECRET_KEYS = ('WIFI_PASSWORD', 'WIFI2_PASSWORD', 'WIFI3_PASSWORD', 'WIFI4_PASSWORD', 'HA_TOKEN', 'ROOT_PASSWORD',
               'RESCUE_PASSWORD')


def P(path):
    return ROOT + path


STATE_DIR = P('/var/lib/dash-firstboot')


# ---------------------------------------------------------------------------------------------------------------
# Hjälpfunktioner
# ---------------------------------------------------------------------------------------------------------------
def log(msg):
    print('dash-firstboot: ' + msg, flush=True)
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        path = STATE_DIR + '/log'
        with open(path, 'a', encoding='utf-8') as f:
            f.write('%s %s\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), msg))
        if os.path.getsize(path) > 100000:
            with open(path, 'rb') as f:
                f.seek(-50000, 2)
                tail = f.read().split(b'\n', 1)[-1]
            with open(path, 'wb') as f:
                f.write(tail)
    except OSError:
        pass


def run(cmd, input=None, timeout=120):
    """Kör ett kommando. Loggar bara kommandots namn (lösenord går via stdin och loggas aldrig)."""
    if NOEXEC:
        with open(P('/noexec.log'), 'a', encoding='utf-8') as f:
            f.write('%s%s\n' % (' '.join(cmd), '  <<< ' + input.strip() if input else ''))
        return subprocess.CompletedProcess(cmd, 0, '', '')
    try:
        return subprocess.run(cmd, input=input, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 127, '', str(e))


def read_text(path, default=None):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return default


def write_if_changed(path, data, mode=0o644):
    """Skriver filen atomiskt. Ger True om innehållet ändrades."""
    if isinstance(data, str):
        data = data.encode('utf-8')
    try:
        with open(path, 'rb') as f:
            if f.read() == data:
                os.chmod(path, mode)
                return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    return True


def digest(value):
    return hashlib.sha256(value.encode('utf-8')).hexdigest()


def rand_password(n):
    return ''.join(secrets.choice(WORDS) for _ in range(n))


class State:
    def __init__(self):
        self.path = STATE_DIR + '/state.json'
        try:
            with open(self.path, encoding='utf-8') as f:
                self.d = json.load(f)
        except (OSError, ValueError):
            self.d = {}
        for k in ('applied', 'generated'):
            self.d.setdefault(k, {})

    def changed(self, key, value):
        return self.d['applied'].get(key) != digest(value)

    def mark(self, key, value):
        self.d['applied'][key] = digest(value)

    def save(self):
        write_if_changed(self.path, json.dumps(self.d, indent=1, sort_keys=True) + '\n', 0o600)


# ---------------------------------------------------------------------------------------------------------------
# Konfigurationen på DASHCFG
# ---------------------------------------------------------------------------------------------------------------
def parse_config(text):
    """Ger (dict med sista värdet per nyckel, lista med alla (nyckel, värde) i ordning)."""
    cfg, pairs = {}, []
    for raw in text.lstrip('\ufeff').splitlines():
        line = raw.strip()
        if not line or line[0] in '#;':
            continue
        if '=' not in line:
            log('hoppar över rad utan = i %s' % CFG_FILE)
            continue
        k, v = line.split('=', 1)
        k, v = k.strip().upper(), v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in '"\'':
            v = v[1:-1]
        cfg[k] = v
        pairs.append((k, v))
    return cfg, pairs


class CfgStore:
    """Läser och skriver filer på DASHCFG. Monteras skrivskyddat och görs skrivbart bara en kort stund."""

    def __init__(self):
        self.dir, self.dev, self.mounted = None, None, False

    def open(self):
        if CFG_DIR:
            self.dir = CFG_DIR
            return True
        r = run(['blkid', '-L', CFG_LABEL])
        dev = r.stdout.strip()
        if r.returncode != 0 or not dev:
            log('ingen partition med namnet %s hittades (inställningar kan inte läsas från kortet)' % CFG_LABEL)
            return False
        self.dev = dev
        run(['fsck.vfat', '-a', dev], timeout=90)            # lagar en FAT som lämnats smutsig av ett strömavbrott
        os.makedirs(P(CFG_MNT), exist_ok=True)
        r = run(['mount', '-t', 'vfat', '-o', 'ro,nosuid,nodev,noexec,flush', dev, P(CFG_MNT)])
        if r.returncode != 0:
            log('kunde inte montera %s: %s' % (dev, r.stderr.strip()[:200]))
            return False
        self.dir, self.mounted = P(CFG_MNT), True
        return True

    def _find(self, name):
        try:
            for n in os.listdir(self.dir):
                if n.lower() == name.lower():
                    return os.path.join(self.dir, n)
        except OSError:
            pass
        return None

    def read(self, name):
        if not self.dir:
            return None
        p = self._find(name)
        if not p:
            return None
        with open(p, 'rb') as f:
            return f.read()

    def write(self, name, data):
        if not self.dir:
            return False
        if self.mounted:
            if run(['mount', '-o', 'remount,rw', self.dir]).returncode != 0:
                log('kunde inte göra DASHCFG skrivbar')
                return False
        try:
            path = self._find(name) or os.path.join(self.dir, name)
            tmp = os.path.join(self.dir, '.dash-tmp')
            with open(tmp, 'wb') as f:
                f.write(data if isinstance(data, bytes) else data.encode('utf-8'))
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
            run(['sync'])
            return True
        except OSError as e:
            log('kunde inte skriva %s på kortet: %s' % (name, e))
            return False
        finally:
            if self.mounted:
                run(['mount', '-o', 'remount,ro', self.dir])

    def close(self):
        if self.mounted:
            if run(['umount', self.dir]).returncode != 0:
                run(['umount', '-l', self.dir])
            self.mounted = False


# ---------------------------------------------------------------------------------------------------------------
# Rotpartitionen: växer till kortets storlek (som Armbians egen tjänst, men tål att DASHCFG ligger före på kortet)
# ---------------------------------------------------------------------------------------------------------------
def target_end(cap):
    """Sista sektor för rotpartitionen. Samma regler som Armbian: 5/2/1 % lämnas oanvänt, slut på 16 MiB-gräns."""
    size = cap * 512
    pct = 95 if size < 4 << 30 else 98 if size < 8 << 30 else 99
    last = cap * pct // 100
    return last - (last % 32768) - 1


def grow_root(st):
    src = os.environ.get('DASH_ROOT_DEV')
    if not src:
        r = run(['findmnt', '-n', '-o', 'SOURCE', '/'])
        src = re.sub(r'\[.*\]', '', r.stdout.strip())
    m = re.match(r'^/dev/((?:mmcblk\d+|nvme\d+n\d+|loop\d+))p(\d+)$|^/dev/((?:sd|vd)[a-z]+)(\d+)$', src or '')
    if not m:
        log('okänd rotenhet %r, växer inte partitionen' % src)
        return
    disk = '/dev/' + (m.group(1) or m.group(3))
    part = int(m.group(2) or m.group(4))
    sysp = P('/sys/class/block/') + os.path.basename(src)
    sysd = P('/sys/class/block/') + os.path.basename(disk)
    try:
        start = int(read_text(sysp + '/start'))
        size = int(read_text(sysp + '/size'))
        cap = int(read_text(sysd + '/size'))
    except (TypeError, ValueError):
        log('kunde inte läsa partitionens storlek ur sysfs')
        return
    want_end = target_end(cap)
    if want_end > start + size - 1 + 2048:
        for name in os.listdir(sysd):                    # ligger något annat i vägen?
            if name.startswith(os.path.basename(disk)) and name != os.path.basename(src):
                s2 = int(read_text('%s/%s/start' % (sysd, name), '0'))
                if start < s2 <= want_end:
                    log('en annan partition (%s) ligger före kortets slut, växer inte' % name)
                    return
        new_size = want_end - start + 1
        log('växer %s från %d till %d MiB' % (src, size * 512 >> 20, new_size * 512 >> 20))
        r = run(['sfdisk', '--no-reread', '--no-tell-kernel', '--wipe', 'never', '--wipe-partitions', 'never',
                 '-N', str(part), disk], input=',%d\n' % new_size)
        if r.returncode != 0:
            log('sfdisk misslyckades: %s' % (r.stderr or r.stdout).strip()[:300])
            return
        r = run(['partx', '-u', disk])
        if r.returncode != 0:
            log('partx: %s' % (r.stderr or r.stdout).strip()[:200])
        size = int(read_text(sysp + '/size', '0') or 0) if not NOEXEC else new_size
        if size != new_size:
            log('kärnan ser fortfarande den gamla storleken; filsystemet växer vid nästa start')
            return
    cur = int(read_text(sysp + '/size', '0') or 0)
    if st.d.get('fs_sectors') != cur:
        r = run(['resize2fs', src], timeout=900)
        log('resize2fs: %s' % ((r.stdout + r.stderr).strip().splitlines() or ['(ingen utskrift)'])[-1][:200])
        if r.returncode == 0:
            st.d['fs_sectors'] = cur


